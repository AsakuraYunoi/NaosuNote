{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NaosuNote",
  "version": "0.2.1",
  "identifier": "com.naosunote.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NaosuNote",

        "width": 1200,
        "height": 860,
        "minWidth": 980,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 18
        },
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/html2pdf": "../platforms/macos/bin/html2pdf"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
